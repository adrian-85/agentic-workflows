# Python bytecode
__pycache__/
*.pyc

# Personal files
*.docx
*.pdf

# Session artifacts: pasted job descriptions, save() drift sidecars
resume-tailoring/jd_*.txt
*.drift.json

# LinkedIn data exports (personal — stay local)
resume-tailoring/Basic_LinkedInDataExport_*/

# ATS Check scan credentials + reports (session cookies, resume text —
# stay local; dot-dir also protects against blanket `git add *` staging)
resume-tailoring/.ats-check/
resume-tailoring/*.ats-check.json

# AI Judge reports (local transcript analyses — never publish)
*/findings/*
*/judgments/*

# Local git identity file — do not commit
.gitconfig
